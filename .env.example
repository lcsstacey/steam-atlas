# Steam Web API key — get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY="your-steam-web-api-key"

# Long random string used to sign session cookies.
# Generate with:  openssl rand -hex 32   (or any 64+ char hex/base64 secret)
AUTH_SECRET="generate-a-long-random-secret"

# Public app URL — used for OpenID return-to and absolute links.
# Local: http://localhost:3000  ·  Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──────────────── Database ────────────────
# Used by `prisma migrate dev` for local schema work.
DATABASE_URL="file:./prisma/dev.db"

# Production: set these instead. The runtime adapter (lib/prisma.ts) uses
# Turso when TURSO_DATABASE_URL is set, otherwise falls back to the
# local dev.db file.
# Sign up at https://turso.tech, then `turso db create <name>` and
# `turso db tokens create <name>` to get these values.
# TURSO_DATABASE_URL="libsql://your-db-name-yourorg.turso.io"
# TURSO_AUTH_TOKEN="ey..."
