# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.tmp-visual-qa*.png

# env files — keep .env.example tracked, ignore real ones
.env
.env.local
.env.development
.env.production
.env.*.local

# Claude Code local config and lock files
.claude/

# SQLite dev database (may contain real user data)
prisma/dev.db
prisma/dev.db-journal
*.sqlite
*.sqlite3

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.vercel/
